System = CsPbBr3

#Start parameters
ISTART =      1  #  job   : 0-new  1-cont  2-samecut
ICHARG =      1  #  charge: 1-file 2-atom 10-const
INIWAV =      1  #  electr: 0-lowe 1-rand

# Convergence tolerance 
EDIFF = 1e-8
SYMPREC = 1e-5
ALGO = NORMAL
NELM = 40

# High prec for force calculations
ENAUG = 1 
ADDGRID = .TRUE.

# Turn Symmetry On (1,2,3) or Off (0,-1)
#ISYM = -1 # Set to -1 for Cubic structures

# Density of States Info
NEDOS = 3001
EMIN = -15
EMAX = 15

LORBIT = 11

# BZ Integrations
ISMEAR = 0 # 0=Gaussian, -5=Tetrahedron method 
SIGMA = 0.01 # Smearing width for Gaussian

#Mixing
#AMIX = 0.2
#BMIX = 0.0001
#AMIX_MAG = 0.8 
#BMIX_MAG = 0.0001

# Calculation Details
LWAVE = .FALSE. # Do we want to write the wavefunctions
LCHARGE = .FALSE. # Do we want to write the charge density (usually <1GB)
PREC = Accurate # ENCUT set according to PAW 
ENCUT = REPLACED-ENCUT-VALUE
LREAL = .FALSE. # automatic optimazation of projectors
LELF = .FALSE. # Generate ELFCAR
#NELECT = 40.00

#LSDA + U
#LDAU = .TRUE.   # Use Hubbard U or not
#LDAUTYPE = 2    # Method of Dudarev
#LDAUL = -1 2 -1 # Which species will have Hubbard U enabled
#LDAUU = 0 3.9 0 # Effective U is U-J
#LDAUJ = 0 0 0
#LMAXMIX = 4     # Apply to d-orbitals
#LDAUPRINT = 1   # Verbosity of output
#LASPH = .TRUE. # include non-spherical contributions from the gradient corrections inside the PAW spheres

# Relaxation parameters
#NSW = 1 # number of ionic steps
#ISIF = 3 # calculate force and relax ions
#IBRION = 8 # CG method for mini_opt
#POTIM = 0.5 # quasi_newton scalar
#EDIFFG = -0.0005

#Magnetism
#ISPIN = 2
#MAGMOM = 16*0 4 4 4 4 -4 -4 -4 -4 -4 -4 -4 -4 4 4 4 4 40*0

#Parallelization
LPLANE = .TRUE.
#NPAR   = 4
LSCALU = .FALSE.
NSIM   = 4
GGA = PS
